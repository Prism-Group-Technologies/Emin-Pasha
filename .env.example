# Copy to .env.local and fill in. Never commit .env.local — see .gitignore.
# No secrets belong in this file; it documents shape only.

NODE_ENV=development

# Canonical origin for sitemap.xml, robots.txt, metadataBase and every
# canonical/OG URL. Defaults to https://www.eminpasha.com in src/config/env.ts,
# so production needs no override — set this only to point an environment
# somewhere else (localhost for dev, a preview domain for staging).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Yanolja Cloud Solution (eZee Reservation) — booking engine
# SERVER-ONLY. Never prefix any of these NEXT_PUBLIC_*.
# Leave blank to run on the enquiry fallback (the site works fine without them).
# ─────────────────────────────────────────────────────────────────────────────

# TODO(EMIN-Q50): property code + keys from the YCS/eZee back office.
YCS_HOTEL_CODE=
YCS_API_KEY=
YCS_AUTH_CODE=

# OPTIONAL OVERRIDE. The live engine URL is public and now lives in
# src/config/bookingEngine.ts (Q49 resolved — LetsBook / Yanolja). Set this
# only to point an environment at a different engine, e.g. a staging property.
# Blank = use the live URL.
YCS_BOOKING_URL=

# sandbox | live. Stays on sandbox until the operator confirms the credentials
# are production AND that the engine's configured currency is UGX (Q51).
YCS_ENVIRONMENT=sandbox

# Serve the internal design-system route at /styleguide. Leave unset in
# production — the route 404s unless this is exactly "true".
ENABLE_STYLEGUIDE=

# ─────────────────────────────────────────────────────────────────────────────
# Web3Forms — enquiry + contact form delivery (EMIN-Q34)
# ─────────────────────────────────────────────────────────────────────────────
# One access key per approved inbox (§1). Web3Forms delivers to the address
# that owns the key — a per-message recipient is not honoured — so the site's
# department routing is expressed as a choice of key.
#
# These are NEXT_PUBLIC_ and are inlined into the browser bundle by design:
# a Web3Forms access key identifies a form, it does not authorise anything,
# and the provider's own integration puts it in the page. Nothing else may
# follow this precedent — the YCS credentials above stay server-only.
#
# Both optional. Neither set = forms post the API routes, the enquiry is
# logged and the UI shows its honest "inbox not connected yet" copy. Only one
# set = that key takes every enquiry, with the intended desk carried in the
# email as its `Department` field.
NEXT_PUBLIC_WEB3FORMS_KEY_INFO=
NEXT_PUBLIC_WEB3FORMS_KEY_RESERVATIONS=
