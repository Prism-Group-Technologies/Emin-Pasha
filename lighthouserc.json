{
  "ci": {
    "collect": {
      "startServerCommand": "yarn start -p 3000",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/accommodation",
        "http://localhost:3000/accommodation/superior-room",
        "http://localhost:3000/dining",
        "http://localhost:3000/spa",
        "http://localhost:3000/weddings",
        "http://localhost:3000/our-story",
        "http://localhost:3000/contact"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1500 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
